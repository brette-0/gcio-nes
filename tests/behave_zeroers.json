[
  "label UnifiedTrigger: bit 4 (=0x10), 8-bit MSB-first pattern 00010000",
  "send_cmd behave 00010000",
  "label   poll with lt=50, rt=200 -> arr[6]=200 (max), arr[7]=0",
  "gc clear",
  "gc lt 50",
  "gc rt 200",
  "poll",
  "expect_buf output 00 00 00 00 00 00 c8 00",

  "label   poll with lt=200, rt=50 -> arr[6]=200 (already max), arr[7]=0",
  "gc clear",
  "gc lt 200",
  "gc rt 50",
  "poll",
  "expect_buf output 00 00 00 00 00 00 c8 00",

  "label NoTriggers: bit 5 (=0x20), pattern 00100000",
  "send_cmd behave 00100000",
  "gc clear",
  "gc lt 100",
  "gc rt 200",
  "poll",
  "expect_buf output 00 00 00 00 00 00 00 00",

  "label NoCStick: bit 6 (=0x40), pattern 01000000",
  "send_cmd behave 01000000",
  "gc clear",
  "gc lstick 10 20",
  "gc cstick 80 90",
  "poll",
  "expect_buf output 00 00 0a 14 00 00 00 00",

  "label NoLStick: bit 7 (=0x80), pattern 10000000",
  "send_cmd behave 10000000",
  "gc clear",
  "gc lstick 10 20",
  "gc cstick 80 90",
  "poll",
  "expect_buf output 00 00 00 00 50 5a 00 00",

  "label NoLStick + NoCStick + NoTriggers: pattern 11100000",
  "send_cmd behave 11100000",
  "gc clear",
  "gc lstick 10 20",
  "gc cstick 80 90",
  "gc lt 100",
  "gc rt 200",
  "gc a 1",
  "poll",
  "# Only buttons survive: A is in arr[0] bit 0 — but ButtonPreprocess remaps IA -> buttons[1] bit 0",
  "expect_buf output 00 01 00 00 00 00 00 00",

  "label NoTriggers wins over UnifiedTrigger: pattern 00110000",
  "send_cmd behave 00110000",
  "gc clear",
  "gc lt 100",
  "gc rt 200",
  "poll",
  "expect_buf output 00 00 00 00 00 00 00 00"
]
